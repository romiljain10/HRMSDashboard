# BambooHR API credentials
# Get your API key from: BambooHR > Account > API Keys
# Subdomain is the "companySubDomain" in https://companySubDomain.bamboohr.com
BAMBOOHR_SUBDOMAIN=sandbox
BAMBOOHR_API_KEY=sandbox-placeholder-key

# Optional: seconds to cache server-side responses (directory, departments, etc.)
BAMBOOHR_CACHE_TTL=60

# Login for this dashboard. Two options:
#
# Option A — multiple users with roles (recommended). Set USERS_JSON to a
# JSON array. Valid roles: "Admin", "Payroll Manager", "Viewer".
# Admin: full access, including Team Access list in Settings.
# Payroll Manager: full access except Team Access.
# Viewer: read-only — report exports are hidden.
# Example (put this all on one line as the env var value):
# USERS_JSON=[{"username":"jsmith","password":"changeme1","name":"John Smith","role":"Admin"},{"username":"viewer","password":"changeme2","name":"Read Only","role":"Viewer"}]
#
# Option B — single shared password (legacy/simple). If USERS_JSON isn't
# set, ADMIN_PASSWORD below creates one fallback user: username "admin".
ADMIN_PASSWORD=change-me

# Secret used to sign login sessions. Falls back to ADMIN_PASSWORD if unset,
# but set this explicitly once you're using USERS_JSON.
SESSION_SECRET=change-this-too

# MongoDB Atlas — powers revenue uploads, tips, report scheduling, payroll
# approval history, and self-service user management. Get the connection
# string from your Atlas cluster (Connect > Drivers > Node.js).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hrms

# Resend (resend.com) — sends scheduled report emails. Get an API key from
# your Resend dashboard, and verify a sending domain (or use their shared
# test domain while developing) to set RESEND_FROM_EMAIL.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=reports@yourdomain.com

# Random string that protects /api/cron/send-reports from being triggered
# by anyone who finds the URL. Vercel automatically sends this as a Bearer
# token when it calls the cron job (see vercel.json) — you just need to set
# the same value here so the route can verify it.
CRON_SECRET=change-this-to-something-random
